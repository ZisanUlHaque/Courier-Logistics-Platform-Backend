NODE_ENV=development
PORT=5000

# PostgreSQL database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/courier_logistics?schema=public"

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# JWT Configuration
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# Base URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Google OAuth
GOOGLE_CLIENT_ID=

# System Default Admin Seed
ADMIN_NAME="System Admin"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

# Tester Customer Seed
TESTER_CUSTOMER_NAME="Tester Customer 1"
TESTER_CUSTOMER_EMAIL=customer@example.com
TESTER_CUSTOMER_PASSWORD=Customer@12345

# Tester Courier Seed
TESTER_COURIER_NAME="Tester Courier 1"
TESTER_COURIER_EMAIL=courier@example.com
TESTER_COURIER_PASSWORD=Courier@12345

# Redis Cloud Setup
REDIS_USER=
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=

# Email Service (SMTP)
SMTP_USER=
SMTP_PASSWORD=
EMAIL_SENDER=

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# bKash Sandbox Checkout Credentials
BKASH_BASE_URL=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_CALLBACK_URL=