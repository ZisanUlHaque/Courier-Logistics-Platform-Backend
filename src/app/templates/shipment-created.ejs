<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shipment Confirmed</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; background-color: #f4f4f7; padding: 20px; }
    .container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 20px rgba(0,0,0,0.08); }
    .header { background: linear-gradient(135deg, #1e3a5f, #2d6a9f); padding: 30px; text-align: center; }
    .header h1 { color: #ffffff; font-size: 24px; }
    .body { padding: 30px; }
    .greeting { font-size: 18px; color: #333; margin-bottom: 15px; }
    .message { color: #555; font-size: 15px; line-height: 1.6; margin-bottom: 15px; }
    .tracking-box { background: #eaf2f8; border: 2px solid #2d6a9f; border-radius: 8px; padding: 20px; text-align: center; margin: 20px 0; }
    .tracking-label { color: #666; font-size: 13px; }
    .tracking-number { font-size: 28px; font-weight: 700; color: #1e3a5f; letter-spacing: 3px; margin-top: 5px; }
    .details { background: #f8f9fa; border-radius: 8px; padding: 15px; margin: 15px 0; }
    .details p { color: #555; font-size: 14px; margin-bottom: 8px; }
    .details strong { color: #333; }
    .cta-btn { display: inline-block; background: #2d6a9f; color: #fff; padding: 12px 30px; border-radius: 6px; text-decoration: none; font-weight: 600; }
    .footer { background: #f8f9fa; padding: 20px; text-align: center; color: #888; font-size: 12px; border-top: 1px solid #eee; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>📦 Shipment Created!</h1>
    </div>
    <div class="body">
      <p class="greeting">Hello <strong><%= name %></strong>,</p>
      <p class="message">Your shipment has been created successfully. Here are the details:</p>
      <div class="tracking-box">
        <p class="tracking-label">Tracking Number</p>
        <p class="tracking-number"><%= trackingNumber %></p>
      </div>
      <div class="details">
        <p><strong>Package:</strong> <%= packageType %></p>
        <p><strong>Weight:</strong> <%= weight %> kg</p>
        <p><strong>Delivery Fee:</strong> ৳<%= deliveryFee %></p>
        <p><strong>Status:</strong> <%= status %></p>
      </div>
      <p class="message">
        <a href="<%= frontendUrl %>/track/<%= trackingNumber %>" class="cta-btn">Track Shipment →</a>
      </p>
    </div>
    <div class="footer">
      <p>&copy; 2026 CourierX Logistics. All rights reserved.</p>
    </div>
  </div>
</body>
</html>